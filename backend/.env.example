# Runtime
APP_ENV=development
APP_NAME=FXNexus
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173
DATABASE_URL=sqlite:///./fxnexus.db
SEED_DEMO_DATA=true

# Local demo login accounts (change before sharing or deploying)
DEMO_MAKER_EMAIL=maker@fxnexus.local
DEMO_MAKER_PASSWORD=Maker-Demo-2026!
DEMO_CHECKER_EMAIL=checker@fxnexus.local
DEMO_CHECKER_PASSWORD=Checker-Demo-2026!
DEMO_SESSION_HOURS=8

# Zoho Books OAuth (India data centre). Keep all values server-side.
ZOHO_CLIENT_ID=PASTE_ZOHO_CLIENT_ID_HERE
ZOHO_CLIENT_SECRET=PASTE_ZOHO_CLIENT_SECRET_HERE
# Self Client scopes required: ZohoBooks.settings.READ,ZohoBooks.invoices.READ,ZohoBooks.customerpayments.READ
ZOHO_REFRESH_TOKEN=PASTE_ZOHO_REFRESH_TOKEN_HERE
# Leave blank until the Connections page lists your accessible Books organisations.
ZOHO_ORGANIZATION_ID=
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in
ZOHO_API_BASE_URL=https://www.zohoapis.in/books/v3
ZOHO_REDIRECT_URI=http://localhost:8000/api/integrations/zoho/callback

# Reference FX data (optional; indicative only)
TWELVE_DATA_API_KEY=PASTE_TWELVE_DATA_API_KEY_HERE
TWELVE_DATA_BASE_URL=https://api.twelvedata.com

# Optional natural-language explanation. Calculations never call an LLM.
OPENAI_API_KEY=PASTE_OPENAI_API_KEY_HERE
OPENAI_MODEL=gpt-6-mini

# Optional hosted Postgres / Supabase direct connection.
# Example: postgresql+psycopg://postgres.<ref>:<password>@<pooler-host>:6543/postgres
# DATABASE_URL=PASTE_POSTGRES_CONNECTION_STRING_HERE
